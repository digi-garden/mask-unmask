{
  "name": "mask-unmask",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-build.mjs && vite build && node scripts/finalize-build.mjs && node scripts/copy-runtime-licenses.mjs && node scripts/verify-build-headers.mjs && node scripts/verify-build-redirects.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run src/utils/maskEngine.perf.test.ts",
    "test:e2e": "npm run build && playwright test",
    "type-check": "tsc --noEmit",
    "demo:video": "node scripts/generate-demo-video.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:production:browser": "node scripts/verify-production-browser.mjs",
    "audit:oss": "node scripts/audit-oss-lock.mjs",
    "audit:distribution": "node scripts/audit-distribution.mjs",
    "verify:production:oss": "node scripts/verify-production-oss.mjs",
    "verify:recovery:candidates": "node scripts/verify-recovery-candidates.mjs",
    "audit:production-deps": "npm audit --omit=dev --audit-level=high",
    "scan:dist:secrets": "node scripts/scan-dist-secrets.mjs",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs && node scripts/verify-standalone.mjs",
    "test:phase5": "playwright test --config playwright.phase5.config.ts",
    "test:production-vram": "playwright test --config playwright.production-vram.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
